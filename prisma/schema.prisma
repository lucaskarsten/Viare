generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(STUDENT)
  birthDate     DateTime?
  ageConfirmedAt DateTime? // RULE: CONTENT-07 — age confirmation timestamp
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  progress     UserProgress[]
  achievements UserAchievement[]
  streak       UserStreak?
  subscription Subscription?
  enrollments  Enrollment[]
  courses      Course[]          @relation("CourseAuthor")
  labAttempts  LabAttempt[]
  hintReveals  HintReveal[]
  xp           UserXP?
  quizAttempts QuizAttempt[]
  reviewCards  ReviewCard[]
  certificates Certificate[]
  reflections  ReflectionResponse[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Course hierarchy ──────────────────────────────────────────────────────

model Course {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  description      String         @db.Text
  topic            String // normalized topic key, e.g. "kali-linux"
  category         CourseCategory @default(TECH)
  tags             String[]
  image            String?
  difficulty       Difficulty     @default(MEDIUM)
  estimatedHours   Int?
  status           CourseStatus   @default(DRAFT)
  sourceType       CourseSource   @default(AI_GENERATED)
  parentCourseId   String? // set when forked from another course
  createdById      String
  avgRating        Float          @default(0)
  totalRatings     Int            @default(0)
  totalEnrollments Int            @default(0)
  enrichCount      Int            @default(0)
  generationPrompt String?        @db.Text // original user prompt
  language         String         @default("pt") // ISO 639-1 code used for generation prompts
  scope            CourseScope    @default(COMPLETE) // RULE: COURSE-06 — user-defined generation depth
  requiresReview   Boolean        @default(false) // RULE: CONTENT-03 — flagged for manual review
  maturityRating   MaturityRating @default(GENERAL) // RULE: CONTENT-06 — maturity classification for age gate
  reviewReason     ReviewReason?  // RULE: CONTENT-03/CONTENT-09 — reason requiresReview was flagged
  // Lesson-chunked generation tracking
  generatingLessonCount Int       @default(0) // advisory mutex counter; reconciled by Cron every 2 min
  finalizedAt           DateTime? // set after content-safety pass; gates all consumption surfaces
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  createdBy    User         @relation("CourseAuthor", fields: [createdById], references: [id])
  parentCourse Course?      @relation("CourseForks", fields: [parentCourseId], references: [id])
  forks        Course[]     @relation("CourseForks")
  modules      Module[]
  enrollments  Enrollment[]
  certificates Certificate[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  slug        String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, slug])
}

model Lesson {
  id        String     @id @default(cuid())
  moduleId  String
  courseId  String? // denormalized from module.courseId; backfilled on migration, set on all new lessons
  slug      String
  title     String
  type      LessonType
  order     Int        @default(0)
  content              String?  @db.Text // AI-generated markdown content
  mdxPath              String? // path for manually-authored MDX lessons
  generationFailed     Boolean  @default(false) // RULE: CONTENT-06 — set when model refused mature topic after retry
  lessonGenerationStatus LessonGenerationStatus @default(PENDING)
  claimedAt              DateTime? // set when a producer starts generating; cleared on DONE/FAILED
  generationAttempts     Int       @default(0)
  lastGenerationError    String?
  idempotencyKey         String?   @unique // client-supplied key for dedup within 60s
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      UserProgress[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]
  reviewCards   ReviewCard[]
  lab           Lab?
  projectSteps  ProjectStep[]
  reflections   ReflectionResponse[]

  @@unique([moduleId, slug])
  @@index([courseId, lessonGenerationStatus])
}

model ReflectionResponse {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── Lesson content types ──────────────────────────────────────────────────

model QuizQuestion {
  id           String   @id @default(cuid())
  lessonId     String
  question     String   @db.Text
  options      Json // string[]
  correctIndex Int
  explanation  String   @db.Text
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Lab {
  id              String     @id @default(cuid())
  lessonId        String     @unique
  title           String
  description     String     @db.Text
  scenario        String     @db.Text
  objectives      Json // string[]
  hints           Json // { text: string, cost: number }[]
  // RULE: LAB-04 — Lab.type discriminates CTF (flag validation) vs INTERACTIVE (self-declaration)
  type            LabType    @default(CTF)
  flagHash        String? // null for INTERACTIVE labs (CHECK constraint enforces this)
  templateId      String?
  templateVersion Int?
  config          Json?
  difficulty      Difficulty @default(MEDIUM)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    LabAttempt[]
  hintReveals HintReveal[]
}

model LabAttempt {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  isCorrect   Boolean
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([userId, labId])
}

model HintReveal {
  id         String   @id @default(cuid())
  userId     String
  labId      String
  hintIndex  Int
  revealedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId, hintIndex])
}

model UserXP {
  userId String @id
  points Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectStep {
  id             String         @id @default(cuid())
  lessonId       String
  title          String
  description    String         @db.Text
  order          Int            @default(0)
  completionType CompletionType @default(MANUAL)
  createdAt      DateTime       @default(now())

  lesson   Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress ProjectStepProgress[]
}

// ─── Enrollment & reviews ──────────────────────────────────────────────────

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  status          EnrollmentStatus @default(IN_PROGRESS)
  progressPercent Int              @default(0)
  lastAccessedAt  DateTime?
  customContext   Json? // personalization context for pro users
  baseLessonCount Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  review      Review?
  certificate Certificate?

  @@unique([userId, courseId])
}

model Review {
  id           String   @id @default(cuid())
  enrollmentId String   @unique
  rating       Int // 1-5
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

// ─── Progress & gamification ───────────────────────────────────────────────

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model ProjectStepProgress {
  id          String   @id @default(cuid())
  userId      String
  stepId      String
  completedAt DateTime @default(now())

  step ProjectStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
}

model Achievement {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  icon         String
  triggerEvent String
  createdAt    DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Subscription / billing ────────────────────────────────────────────────

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  stripeCustomerId String             @unique
  stripeSubId      String?            @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(INACTIVE)
  validUntil       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Quiz attempts & spaced repetition ────────────────────────────────────

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  score     Int
  total     Int
  answers   Json // [{ questionId, selectedIndex, correct }]
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

model ReviewCard {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  front       String   @db.Text
  back        String   @db.Text
  easeFactor  Float    @default(2.5)
  interval    Int      @default(1)
  repetitions Int      @default(0)
  dueAt       DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviews CardReview[]

  @@unique([userId, lessonId, front])
  @@index([userId, dueAt])
}

model CardReview {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  rating    Int
  createdAt DateTime @default(now())

  card ReviewCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// ─── Certificates ─────────────────────────────────────────────────────────

model Certificate {
  id                  String    @id @default(cuid())
  uuid                String    @unique @default(uuid())
  userId              String
  courseId            String
  enrollmentId        String    @unique
  userNameSnapshot    String
  courseTitleSnapshot String
  hoursSnapshot       Int
  issuedAt            DateTime  @default(now())
  revokedAt           DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum CourseCategory {
  TECH
  LANG
  MUSIC
  CRAFT
  SCIENCE
  LIFE
}

enum Role {
  STUDENT
  ADMIN
}

enum CourseStatus {
  DRAFT
  GENERATING
  PUBLISHED
  ARCHIVED
}

enum CourseSource {
  AI_GENERATED
  AI_FORKED
  MANUAL
}

enum LessonType {
  THEORY
  QUIZ
  LAB
  PROJECT
  CASE_STUDY
  REFLECTION
  PRACTICE
}

enum LabType {
  CTF
  INTERACTIVE
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CompletionType {
  MANUAL
  AUTO
}

enum CourseScope {
  OVERVIEW
  COMPLETE
  DEEP
}

enum SubscriptionPlan {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}

enum MaturityRating {
  GENERAL
  MATURE
}

enum ReviewReason {
  CONTENT_RESTRICTED
  GENERATION_INCOMPLETE
}

enum LessonGenerationStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}
